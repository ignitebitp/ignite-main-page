# ==============================================================
# IGNITE CONFIGURATION (FOR VERCEL & LOCAL DEV)
# ==============================================================

# PostgreSQL Prisma Connection String (e.g., Neon, Supabase, Vercel Postgres)
# Direct connection / pooled connection:
DATABASE_URL="postgresql://user:password@host:5432/ignite?sslmode=require&pgbouncer=true"

# (Legacy / Fallback) MongoDB Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ignite?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# (Optional) Email Configuration for OTPs and notifications
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# (Optional) AI Question Generation Key (Groq)
GROQ_API_KEY=gsk_your_groq_api_key_here

# (Optional) Base API URL - leave blank on Vercel for same-origin relative requests
NEXT_PUBLIC_API_URL=
